+static void gs_bus_off_work(struct work_struct *work)
+{
+	struct gs_can *dev = container_of(work, struct gs_can, bus_off_work);
+	unsigned long flags;
+
+	/* Neither CAN core nor completion callbacks may race echo teardown. */
+	netif_tx_disable(dev->netdev);
+	usb_kill_anchored_urbs(&dev->tx_submitted);
+	spin_lock_irqsave(&dev->io_lock, flags);
+	if (!dev->closing) {
+		can_bus_off(dev->netdev);
+		dev->can.state = CAN_STATE_BUS_OFF;
+	}
+	spin_unlock_irqrestore(&dev->io_lock, flags);
+}
+
+static struct gs_tx_context *gs_get_echo_context(struct gs_can *dev, u32 token)
+{
+	struct gs_tx_context *txc;
+
+	txc = gs_get_tx_context(dev, token % GS_MAX_TX_URBS);
+	if (dev->can.do_set_mode &&
+	    (!txc || txc->echo_done || txc->wire_echo_id != token))
+		return NULL;
+	return txc;
+}
