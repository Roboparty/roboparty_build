+static netdev_tx_t gs_can_start_xmit(struct sk_buff *skb,
+				     struct net_device *netdev)
+{
+	struct gs_can *dev = netdev_priv(netdev);
+	unsigned long flags;
+	netdev_tx_t rc;
+
+	if (!dev->can.do_set_mode)
+		return gs_can_start_xmit_locked(skb, netdev);
+
+	spin_lock_irqsave(&dev->io_lock, flags);
+	if (dev->restarting || dev->closing) {
+		netif_stop_queue(netdev);
+		rc = NETDEV_TX_BUSY;
+	} else {
+		rc = gs_can_start_xmit_locked(skb, netdev);
+	}
+	spin_unlock_irqrestore(&dev->io_lock, flags);
+	return rc;
+}
+
+static int gs_cmd_restart_start(struct gs_can *dev,
+				const struct gs_device_mode *dm)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(100);
+	unsigned long now;
+	unsigned int timeout_ms;
+	int attempt, rc = -EPIPE;
+
+	/* RESET retains an in-flight IN buffer until its completion IRQ. Only
+	 * restart START may briefly stall while that ownership is released.
+	 */
+	for (attempt = 0; attempt < 5; attempt++) {
+		if (READ_ONCE(dev->closing))
+			return -ENODEV;
+		now = jiffies;
+		if (time_after_eq(now, deadline))
+			break;
+		timeout_ms = jiffies_to_msecs(deadline - now);
+		if (!timeout_ms)
+			timeout_ms = 1;
+		rc = usb_control_msg_send(dev->udev, 0, GS_USB_BREQ_MODE,
+					  USB_DIR_OUT | USB_TYPE_VENDOR | USB_RECIP_INTERFACE,
+					  dev->channel, 0, dm, sizeof(*dm),
+					  timeout_ms, GFP_KERNEL);
+		if (rc != -EPIPE || attempt == 4)
+			return rc;
+		if (time_after_eq(jiffies + msecs_to_jiffies(20), deadline))
+			break;
+		msleep(20);
+	}
+
+	return rc;
+}
+
+static bool gs_hpm_bus_off_restart_supported(const struct usb_device *udev)
+{
+	unsigned int major, minor, patch;
+
+	if (le16_to_cpu(udev->descriptor.idVendor) != USB_CANDLELIGHT_VENDOR_ID ||
+	    le16_to_cpu(udev->descriptor.idProduct) != USB_CANDLELIGHT_PRODUCT_ID ||
+	    !udev->product)
+		return false;
+
+	/* roboto_usb4can implements channel-local RESET since v1.1.0. */
+	return sscanf(udev->product, "roboto_usb4can v%u.%u.%u",
+		      &major, &minor, &patch) == 3 &&
+	       (major > 1 || (major == 1 && minor >= 1));
+}
+
+static int gs_can_set_mode(struct net_device *netdev, enum can_mode mode)
+{
+	struct gs_can *dev = netdev_priv(netdev);
+	struct gs_device_mode dm = {
+		.mode = cpu_to_le32(GS_CAN_MODE_START),
+		.flags = cpu_to_le32(dev->mode_flags),
+	};
+	unsigned long flags;
+	int rc, i;
+
+	if (mode != CAN_MODE_START)
+		return -EOPNOTSUPP;
+	if (READ_ONCE(dev->closing))
+		return -ENODEV;
+
+	/* bus_off_work already stopped TX; CAN core has flushed echo SKBs. */
+	rc = gs_cmd_reset(dev);
+	if (rc)
+		return rc;
+	for (i = 0; i < GS_MAX_TX_URBS; i++)
+		gs_free_tx_context(&dev->tx_context[i]);
+	atomic_set(&dev->active_tx_urbs, 0);
+
+	rc = gs_usb_set_bittiming(dev);
+	if (rc)
+		return rc;
+	if (dev->can.ctrlmode & CAN_CTRLMODE_FD) {
+		rc = gs_usb_set_data_bittiming(dev);
+		if (rc)
+			return rc;
+	}
+	rc = gs_cmd_restart_start(dev, &dm);
+	if (rc)
+		return rc;
+
+	spin_lock_irqsave(&dev->io_lock, flags);
+	if (dev->closing) {
+		rc = -ENODEV;
+	} else {
+		dev->can.state = CAN_STATE_ERROR_ACTIVE;
+		dev->restarting = false;
+		if (!(dev->can.ctrlmode & CAN_CTRLMODE_LISTENONLY))
+			netif_wake_queue(netdev);
+	}
+	spin_unlock_irqrestore(&dev->io_lock, flags);
+	return rc;
+}
