+/* HPM contexts remain owned until both the OUT completion and echo arrive. */
+static void gs_finish_tx_context(struct gs_tx_context *txc)
+{
+	struct gs_can *dev = txc->dev;
+
+	if (txc->urb_pending || !txc->echo_done)
+		return;
+	gs_free_tx_context(txc);
+	atomic_dec(&dev->active_tx_urbs);
+	netif_wake_queue(dev->netdev);
+}
